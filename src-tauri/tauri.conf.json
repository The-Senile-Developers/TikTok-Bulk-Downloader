{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TikTok Bulk Downloader",
  "version": "0.0.4",
  "identifier": "codes.senile.ttbd",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TikTok Bulk Downloader",
        "width": 900,
        "height": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "cookies.txt",
      "libs/yt-dlp.exe",
      "libs/ffmpeg.exe"
    ],
    "targets": "nsis",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}